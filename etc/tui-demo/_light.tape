# The palette of the user's Alacritty.
Set Theme '{"name":"Alacritty light","background":"#fffefe","foreground":"#000000","cursor":"#0550ae","black":"#000000","red":"#c91b00","green":"#066c06","yellow":"#e55611","blue":"#0225c7","magenta":"#c930c7","cyan":"#0073c7","white":"#c7c7c7","brightBlack":"#4c4c4c","brightRed":"#ff6d67","brightGreen":"#1a7a1a","brightYellow":"#fe9a67","brightBlue":"#6871ff","brightMagenta":"#ff76ff","brightCyan":"#1e81b0","brightWhite":"#6b6868"}'
# Announcements dim a light terminal with a light grey, not to dark grey.
Set AnnounceDimColor "#808080"
Set AnnounceDimOpacity 0.3
